# ============================================================
# SignalDesk batch — 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# ============================================================

# ---- 한국투자증권 KIS Developers ----
# https://apiportal.koreainvestment.com 에서 앱 등록 후 발급
KIS_APP_KEY=
KIS_APP_SECRET=
# 실전: https://openapi.koreainvestment.com:9443
# 모의: https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- 배치 파라미터 ----
# 조회 최대 거래일 수(지표 워밍업 포함). 3Y 차트까지 원하면 800+.
LOOKBACK_TRADING_DAYS=400
REQUEST_DELAY_SEC=0.2

# 국내 지수 코드 (KOSPI). VKOSPI는 코드 확인 후 채우세요(비우면 생략).
KOSPI_INDEX_CODE=0001
VKOSPI_INDEX_CODE=
