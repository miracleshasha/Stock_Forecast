# ============================================================
# SignalDesk web — 환경변수
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# ============================================================

# Supabase 프로젝트 설정 > API 에서 확인
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# 서버 사이드 읽기용. service_role 키 (절대 클라이언트에 노출 금지).
# anon 키만 있어도 동작합니다(공개 SELECT 정책이 있으므로). 이 경우 아래에 anon 키를 넣으세요.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# SUPABASE_ANON_KEY=YOUR-ANON-KEY
